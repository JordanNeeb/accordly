# Copy to supabase/.env (git-ignored). The Supabase CLI reads it for env() values
# in config.toml. Create a Google Cloud OAuth client (type "Web application")
# with the authorized redirect URI http://127.0.0.1:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
