{
  "name": "accordly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @accordly/web",
    "build:web": "npm run build -w @accordly/web",
    "lint:web": "npm run lint -w @accordly/web",
    "start:mobile": "npm run start -w @accordly/mobile",
    "ios": "npm run ios -w @accordly/mobile",
    "android": "npm run android -w @accordly/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
